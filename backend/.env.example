# ─────────────────────────────────────────────────────────────────────────────
#  Aswani Backend – Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── FastAPI ────────────────────────────────────────────────────────────────────
APP_ENV=development               # development | production
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# ── JWT Tokens ────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (15 min default)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days (30 days default)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Database (Supabase Session Pooler on port 5432) ───────────────────────────
# Format: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=postgresql+psycopg2://postgres.PROJECTREF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_URL=https://PROJECTREF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET=images   # the single public bucket

# ── Password Reset ────────────────────────────────────────────────────────────
# HMAC secret for hashing 4-digit reset codes
RESET_CODE_SECRET=change-me-reset-hmac-secret

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@aswani.app

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Uses in-memory store by default; set a Redis URL for multi-instance
# REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (* for dev; real origins for prod)
CORS_ORIGINS=*

# ── Demo Seed Account (matches the mobile mock data) ─────────────────────────
SEED_DEMO_EMAIL=laila@example.com
SEED_DEMO_PASSWORD=Aswan2026
SEED_DEMO_FULL_NAME=Laila Hassan
